# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env.local and fill in. Never commit .env.local.
#
# The public rank tool runs with none of these set — it has no database and no
# sign-in. Everything here exists for /dashboard. A missing DATABASE_URL
# degrades lead capture to log-only rather than breaking the site.
# ─────────────────────────────────────────────────────────────────────────────

# Neon Postgres. Use the POOLED connection string (the host contains "-pooler").
# Neon console → your project → Connection Details → "Pooled connection".
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Google OAuth client (Web application) from console.cloud.google.com.
# Authorised redirect URIs must include, exactly:
#   http://localhost:3000/api/auth/callback/google
#   https://<your-production-domain>/api/auth/callback/google
GOOGLE_CLIENT_ID="xxxxxxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxxxxxxxxxxxxxx"

# Signs the session cookie and salts the rate-limiter's IP hashes.
# Generate with:  openssl rand -base64 32
# Changing it signs everyone out and resets the rate limiter. Must be 32+ chars.
AUTH_SECRET=""

# Who can open the dashboard. Comma-separated. Everyone else is refused even
# with a valid Google account. An empty list denies everyone — this fails
# closed on purpose.
DASHBOARD_ALLOWED_EMAILS="you@gmail.com,client@gmail.com"

# Optional. Pins the OAuth redirect's origin. Leave unset locally and in
# production (it is derived from the request); set it only when a preview
# deployment must use the one redirect URI registered with Google.
# AUTH_URL="https://your-production-domain.com"
